{
  "$schema": "https://opencode.ai/config.json",
  // Subagents default to OpenAI with low reasoning effort. The orchestrator chooses
  // a different reasoning
  // effort per task by passing `model` to the subagent tool, e.g.
  //   "openai/gpt-6.1-terra#none"  trivial, deterministic work
  //   "openai/gpt-6.1-terra#low"   mechanical lookups and small edits
  //   "openai/gpt-6.1-terra#high"  normal research and implementation
  //   "openai/gpt-6.1-terra#max"   deep debugging and adversarial review
  // Verified: the per-call `model` argument overrides this default, so the pinned
  // value only applies when the orchestrator does not pass one.
  "agents": {
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low",
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra#low",
    },
  },
}
