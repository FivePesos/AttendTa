@model LoginViewModel
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Sign in";
}
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}
<div class="container py-5" style="display:flex; align-content:center;height:calc(100vh - 64px)">
    <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-xl-10">
            <div class="card rounded-3 text-black">
                <div class="row g-0 w-1000px">
                    <div class="col-lg-6">
                        <div class="card-body p-md-5 mx-md-4">
                            <div class="text-center">
                                <img src="~/img/asi-logo-invert.svg"
                                     style="width: 185px;" alt="logo">
                            </div>
                            <form method="post" asp-controller="Account" asp-action="Login" id="loginForm">
                                <input type="hidden" asp-for="ReturnUrl" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                                <div class="form-outline mb-4">
                                    <label class="form-label" asp-for="Email"></label>
                                    <input type="email" id="Email" class="form-control"
                                           asp-for="Email" placeholder="Enter your email" autocomplete="username" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="form-outline mb-4">
                                    <label class="form-label" asp-for="Password"></label>
                                    <input type="password" id="Password" class="form-control"
                                           asp-for="Password" placeholder="Enter your password" autocomplete="current-password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="text-center pt-1 mb-5 pb-1 d-flex flex-column align-items-center">
                                    <button class="btn btn-primary btn-block login-btn gradient-custom-2 mb-3" type="submit">
                                        Sign in
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-lg-6 d-flex">
                        <img style="width:400px" src="~/img/LiveIT.png" alt="" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
