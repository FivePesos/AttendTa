@model List<VenueViewModel>
@{
    ViewData["Title"] = "Venues";
}

<div class="page-heading">
    <h2>Venue Management</h2>
    <a asp-action="Create" class="button button-primary">Add Venue</a>
</div>

<div class="table-scroll" role="region" aria-label="Venue table" tabindex="0">
<table class="data-table">
    <thead>
        <tr>
            <th scope="col">Room Name</th>
            <th scope="col">Capacity</th>
            <th scope="col">Location</th>
            <th scope="col">Availability Notes</th>
            <th scope="col">Contact Person</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venue in Model)
        {
            <tr>
                <td>@venue.RoomName</td>
                <td>@venue.Capacity</td>
                <td>@venue.Location</td>
                <td>@venue.AvailabilityNotes</td>
                <td>@venue.ContactPerson</td>
                <td>@(venue.IsActive ? "Active" : "Inactive")</td>
                <td class="actions">
                    <a asp-action="Edit" asp-route-id="@venue.VenueId" class="button button-secondary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@venue.VenueId" method="post" class="inline-form">
                        <button type="submit" class="button button-secondary">@(venue.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (Model.Count == 0)
{
    <p class="empty-state">No records found.</p>
}
