@model PagedResult<AccountRequestQueueItemViewModel>
@using System
@using System.Linq
@{
    ViewData["Title"] = "Account requests";
    var selectedStatus = ViewBag.Status as string ?? "pending";
    var decisionError = ViewBag.DecisionError as string;
    var decisionRequestId = ViewBag.DecisionRequestId as int?;
    var decisionReason = ViewBag.DecisionReason as string;
    var isRejection = ViewBag.IsRejection is true;
    var query = Context.Request.QueryString.ToString();
}

<div class="page-heading">
    <h2>Account Request Queue</h2>
    <span class="muted">Review submitted account requests by status.</span>
</div>

<form asp-action="Index" method="get" class="spacing-bottom">
    <div class="queue-filter">
        <div class="field">
            <label for="status">Request status</label>
            <select id="status" name="status" class="field-control">
                <option value="pending" selected="@(selectedStatus == "pending")">Pending</option>
                <option value="approved" selected="@(selectedStatus == "approved")">Approved</option>
                <option value="rejected" selected="@(selectedStatus == "rejected")">Rejected</option>
            </select>
        </div>
        <button type="submit" class="button button-secondary">Filter</button>
    </div>
</form>

@if (decisionError != null)
{
    <div class="notice notice-error" role="alert">
        @decisionError <a href="@(Url.Action("Index") + query)">Refresh the queue</a>.
    </div>
    @if (isRejection && !Model.Items.Any(item => item.RequestId == decisionRequestId))
    {
        <div class="field">
            <label for="saved-rejection-reason">Your entered rejection reason (copy it before refreshing)</label>
            <textarea id="saved-rejection-reason" class="field-control" rows="2" readonly>@decisionReason</textarea>
        </div>
    }
}

@if (Model.Items.Count == 0)
{
    <p class="empty-state">No @selectedStatus account requests found.</p>
}
else
{
    <div class="table-scroll" role="region" aria-label="Account request table" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Requested</th>
                    <th scope="col">Student Number</th>
                    <th scope="col">Full Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Course</th>
                    <th scope="col">Year</th>
                    <th scope="col">Section</th>
                    <th scope="col">Mobile</th>
                    <th scope="col">Status</th>
                    @if (selectedStatus == "pending") { <th scope="col">Review</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Items)
                {
                    <tr data-request-id="@request.RequestId">
                        <td><time datetime="@(DateTime.SpecifyKind(request.RequestedAt, DateTimeKind.Utc).ToString("O"))" aria-label="Requested at in Asia/Manila">@ManilaTimeFormatter.Format(request.RequestedAt)</time></td>
                        <td>@request.StudentNumber</td>
                        <td>@request.FullName</td>
                        <td>@request.Email</td>
                        <td>@request.Course</td>
                        <td>@request.YearLevel</td>
                        <td>@request.Section</td>
                        <td>@request.MobileNumber</td>
                        <td>@request.Status</td>
                        @if (selectedStatus == "pending")
                        {
                            <td class="queue-review">
                                <form action="@(Url.Action("Approve") + query)" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@request.RequestId" />
                                    <button class="button button-primary" type="submit" aria-label="Approve request from @request.FullName">Approve</button>
                                </form>
                                <form action="@(Url.Action("Reject") + query)" method="post" class="queue-reject">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@request.RequestId" />
                                    <label for="reason-@request.RequestId">Rejection reason for @request.FullName</label>
                                    <textarea id="reason-@request.RequestId" name="reason" class="field-control" rows="2" required aria-invalid="@(decisionRequestId == request.RequestId && isRejection ? "true" : "false")" aria-describedby="@(decisionRequestId == request.RequestId && isRejection ? $"reason-error-{request.RequestId}" : null)">@(decisionRequestId == request.RequestId ? decisionReason : null)</textarea>
                                    @if (decisionRequestId == request.RequestId && isRejection) { <span id="reason-error-@request.RequestId" class="field-error">@decisionError</span> }
                                    <button class="button button-secondary" type="submit" aria-label="Reject request from @request.FullName">Reject</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model" />
}
