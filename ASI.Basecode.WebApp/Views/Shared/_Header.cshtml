@using ASI.Basecode.Resources.Constants
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var management = User.IsInRole(RoleCodes.Admin) || User.IsInRole(RoleCodes.Officer);
    var role = User.IsInRole(RoleCodes.Admin) ? "Administrator" : User.IsInRole(RoleCodes.Officer) ? "Officer" : "Member";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var group = controller switch
    {
        "Home" => NavGroups.Overview,
        "MemberEvents" => NavGroups.Overview,
        "Event" or "EventCover" => NavGroups.Manage,
        "Member" or "DeactivationPreview" => NavGroups.Manage,
        "EventType" => NavGroups.Manage,
        "Venue" => NavGroups.Manage,
        "AccountRequest" or "ManagementAccountRequest" => NavGroups.Manage,
        "AdminAccounts" => NavGroups.Manage,
        "ActivityLog" => NavGroups.Manage,
        "MyEvents" or "Passes" => NavGroups.Records,
        "CheckIn" => NavGroups.Operations,
        "RegistrationReview" => NavGroups.Operations,
        "CertificateLedger" or "MyCertificates" => NavGroups.Operations,
        "Reports" => NavGroups.Operations,
        "Profile" => NavGroups.Account,
        // Access denied is the only Account page management can reach, and the management
        // rail has no Account group, so the trail stops at Home rather than naming one.
        "Account" => string.Empty,
        // An unmapped controller gets no section rather than a fabricated one.
        _ => string.Empty
    };

    var pageLabel = controller switch
    {
        "Home" => "Home",
        "MemberEvents" => management ? "Browse events" : "Events",
        "Event" or "EventCover" => "Events",
        "Member" or "DeactivationPreview" => "Members",
        "EventType" => "Event types",
        "Venue" => "Venues",
        "AccountRequest" or "ManagementAccountRequest" => "Account requests",
        "AdminAccounts" => "Accounts",
        "ActivityLog" => "Activity log",
        "MyEvents" => "My Events",
        "Passes" => "My Passes",
        "CheckIn" => "Check-in",
        "RegistrationReview" => "Registration review",
        "CertificateLedger" or "MyCertificates" => "Certificates",
        "Reports" => "Reports",
        "Profile" => "Profile",
        "Account" => action == "AccessDenied" ? "Access denied" : "Account",
        // An unmapped controller is named as itself, never presented as Home.
        _ => controller
    };
}
@if (authenticated && management)
{
    <aside class="rail" aria-label="Primary">
        <div class="rail-brand">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand-mark" src="~/img/attendta-logo.jpg" alt="" />
                <span>AttendTa<small>University of Cebu</small></span>
            </a>
        </div>
        <nav class="rail-nav" aria-label="Main navigation">
            <partial name="_NavLinks" />
        </nav>
        <partial name="_AccountMenu" model="role" />
    </aside>
    <header class="topbar management-header">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                @if (controller == "Home")
                {
                    @* Home is the trail's root, so it is the current page rather than a link to itself. *@
                    <li aria-current="page">@pageLabel</li>
                }
                else
                {
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    @* The Overview group is Home's own group, so repeating it would imply a level below Home. *@
                    @if (!string.IsNullOrEmpty(group) && group != NavGroups.Overview)
                    {
                        <li><span>@group</span></li>
                    }
                    <li aria-current="page">@pageLabel</li>
                }
            </ol>
        </nav>

        <span class="role-tag topbar-role">@role</span>

        <details class="mobile-menu">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
                <partial name="_NavLinks" />
                <partial name="_AccountIdentity" model="role" />
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-logout">Sign out</button></form>
            </nav>
        </details>
    </header>
}
else if (authenticated)
{
    <header class="topbar member-header">
        <a class="brand member-brand" asp-controller="Home" asp-action="Index">
            <img class="brand-mark" src="~/img/attendta-logo.jpg" alt="" />
            <span>AttendTa<small>University of Cebu</small></span>
        </a>
        <nav class="member-nav" aria-label="Main navigation">
            <a class="nav-key" asp-controller="MemberEvents" asp-action="Index" aria-current="@(controller == "MemberEvents" ? "page" : null)">Events</a>
            <a class="nav-key" asp-controller="MyEvents" asp-action="Index" aria-current="@(controller == "MyEvents" ? "page" : null)">My Events</a>
            <a class="nav-key" asp-controller="Passes" asp-action="Index" aria-current="@(controller == "Passes" ? "page" : null)">My Passes</a>
        </nav>
        <partial name="_AccountMenu" model="role" />
        <details class="mobile-menu">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
                <partial name="_NavLinks" />
                <partial name="_AccountIdentity" model="role" />
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-logout">Sign out</button></form>
            </nav>
        </details>
    </header>
}
else
{
    <header class="public-band">
        <div class="brand-row">
            <div class="brand"><img class="brand-mark" src="~/img/attendta-logo.jpg" alt="" /><span>AttendTa<small>University of Cebu</small></span></div>
        </div>
    </header>
}
